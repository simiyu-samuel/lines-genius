{
  "name": "lines-genius-backend",
  "version": "1.0.0",
  "description": "Backend API for Lines Genius - AI-powered creative line generation platform",
  "main": "api/index.ts",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "rm -rf dist && tsc && npx prisma generate",
    "start": "npx prisma migrate deploy && node dist/server.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "migrate": "npx prisma migrate dev",
    "migrate:deploy": "npx prisma migrate deploy",
    "generate": "npx prisma generate",
    "studio": "npx prisma studio",
    "postinstall": "npx prisma generate",
    "vercel-build": "rm -rf dist && npx prisma generate && tsc",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "api",
    "nodejs",
    "typescript",
    "openai",
    "creative-writing",
    "saas"
  ],
  "author": "Lines Genius Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.7",
    "openai": "^4.24.1",
    "stripe": "^14.9.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.9.0",
    "@types/nodemailer": "^6.4.14",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "@vercel/node": "^3.0.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prisma": "^6.10.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
